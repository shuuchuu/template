[project]
authors = [
{%- for author in project_authors %}
{{author}}
{%- endfor %}
]
dependencies = []
description = "{{project_description}}"
homepage = "{{project_homepage}}"
license = "{{project_license}}"
license-files = ["LICENSE"]
name = "{{project_name}}"
readme = "README.md"
requires-python = ">= 3.13"
version = "0.1.0"

[dependency-groups]
dev = [
{%- if 'bumpver' in tools %}
  "bumpver >= 2026.1132",
{%- endif %}
{%- if 'doit' in tools %}
  "doit >= 0.37",
{%- endif %}
{%- if 'pytest' in tools %}
  "pytest >= 9",
{%- endif %}
  "ruff >= 0.17",
  "ty >= 0.0.88",
]

[tool.ruff]
target-version = "py313"

[tool.ruff.lint]
ignore = [
  "D1",
  "incorrect-blank-line-before-class",
  "multi-line-summary-second-line",
  "non-empty-init-module",
]
preview = true
select = ["A", "B", "C", "D", "DOC", "E", "EM", "F", "I", "N", "PIE", "PTH", "RET", "RUF", "SIM", "SLF", "TC", "UP", "W"]

[tool.ruff.lint.pydocstyle]
convention = "google"
{%- if 'bumpver' in tools %}

[bumpver]
commit = true
tag = true
push = true
commit_message = "Bump version to {new_version}"
current_version = "0.1.0"
pre_commit_hook = "scripts/bumpver_pre_commit.sh"
tag_message = "{new_version}"
version_pattern = "MAJOR.MINOR.PATCH"

[bumpver.file_patterns]
"pyproject.toml" = [
  '^version = "{version}"$',
  '^current_version = "{version}"$',
]
{%- if project_layout == 'package' %}
"src/{{project_id}}/__init__.py" = [
  '^__version__ = "{version}"$',
]
{%- endif %}
{%- endif %}
{%- if project_layout == 'package' %}

[build-system]
build-backend = "uv_build"
requires = ["uv_build>=0.13.1,<0.14.0"]
{%- endif %}
