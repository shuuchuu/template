DOIT_CONFIG = {
    "backend": "json",
    "default_tasks": ["check"],
    "dep_file": ".doit.json",
    "verbosity": 2,
}


{%- if project_layout == 'package' %}
{%- set check_paths = 'src/' ~ project_id ~ (' tests' if 'pytest' in tools else '') %}
{%- else %}
{%- set check_paths = '.' %}
{%- endif %}


def task_check():
    return {
        "actions": [
            "uv run ruff check {{ check_paths }}",
            "uv run ruff format --check {{ check_paths }}",
            "uv run ty check {{ check_paths }}",
        ],
    }
{%- if 'pytest' in tools %}


def task_test():
    return {
        "actions": [
            "uv run pytest",
        ],
    }
{% endif -%}
{%- if 'githooks' in tools %}


def task_install_hooks():
    import os

    actions = ["git config core.hooksPath .githooks"]
    if os.name == "posix":
        actions.append("chmod +x .githooks/*")
    return {
        "actions": actions,
    }
{% endif -%}
