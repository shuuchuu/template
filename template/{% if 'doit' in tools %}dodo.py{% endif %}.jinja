DOIT_CONFIG = {
    "backend": "json",
    "default_tasks": ["check"],
    "dep_file": ".doit.json",
    "verbosity": 2,
}


{%- if project_layout == 'package' %}
{%- set check_paths = 'src/' ~ project_id ~ (' tests' if 'pytest' in tools else '') %}
{%- else %}
{%- set check_paths = '.' %}
{%- endif %}


def task_check():
    return {
        "actions": [
            "uv run ruff check {{ check_paths }}",
            "uv run ruff format --check {{ check_paths }}",
            "uv run ty check {{ check_paths }}",
        ],
    }
{%- if 'pytest' in tools %}


def task_test():
    return {
        "actions": [
            "uv run pytest",
        ],
    }
{%- endif %}
{%- if 'githooks' in tools %}


def task_install_hooks():
    import subprocess

    def unset_hooks_path():
        # Projects generated before the switch to prek pointed git at .githooks,
        # and prek refuses to install while core.hooksPath is set.
        subprocess.run(["git", "config", "--unset-all", "core.hooksPath"], check=False)

    return {
        "actions": [unset_hooks_path, "uv run prek install"],
    }
{%- endif %}
